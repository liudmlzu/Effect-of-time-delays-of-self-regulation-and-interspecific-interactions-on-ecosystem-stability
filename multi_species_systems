tic;

s=1;
sigma=0.05;
C=0.2;
R=200;         
N=200;

ts=0.5;         
tc=1;      

Ss=10:10:200;  

types={'random','predation','competition','mutualism'};
names={'Random','+/-','-/-','+/+'};

alpha=zeros(length(types),length(Ss));

total=length(types)*length(Ss)*R;
cnt=0;

for q=1:length(types)

	type=types{q};

	for a=1:length(Ss)

		S=Ss(a);
		tmp=zeros(R,1);

		for r=1:R

			A=makeA(S,sigma,C,type);
			Ms=-s*eye(S);
			Mc=A;

			tmp(r)=rightmostRoot(Ms,Mc,ts,tc,N);

			cnt=cnt+1;

			if mod(cnt,10)==0 || cnt==1 || cnt==total
				elapsed=toc;
				avgTime=elapsed/cnt;
				remainTime=avgTime*(total-cnt);

				fprintf(['Type: %s | S %d (%d/%d) | R %d/%d | ',...
					'Progress %.2f%% | Elapsed %.2f min | Remaining %.2f min\n'],...
					type,S,a,length(Ss),r,R,...
					100*cnt/total,elapsed/60,remainTime/60);
			end
		end

		alpha(q,a)=mean(tmp);
	end
end

figure('Color','w','Position',[120 120 920 720]);

hold on;

plot(Ss,alpha(1,:),'-o','LineWidth',2.5,'MarkerSize',8);
plot(Ss,alpha(2,:),'-s','LineWidth',2.5,'MarkerSize',8);
plot(Ss,alpha(3,:),'-^','LineWidth',2.5,'MarkerSize',8);
