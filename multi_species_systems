function A=makeA(S,sigma,C,type)

	A=zeros(S);

	for i=1:S-1
		for j=i+1:S
			if rand<C

				a=sigma*randn;
				b=sigma*randn;

				switch type

					case 'random'
						A(i,j)=a;
						A(j,i)=b;

					case 'predation'
						if rand<0.5
							A(i,j)=abs(a);
							A(j,i)=-abs(b);
						else
							A(i,j)=-abs(a);
							A(j,i)=abs(b);
						end

					case 'competition'
						A(i,j)=-abs(a);
						A(j,i)=-abs(b);

					case 'mutualism'
						A(i,j)=abs(a);
						A(j,i)=abs(b);
				end
			end
		end
	end
end

function rho=rightmostRoot(Ms,Mc,ts,tc,N)

	S=size(Ms,1);
	tm=max([ts,tc,1e-8]);

	[x,D]=chebD(N);
	theta=tm*(x-1)/2;
	D=2/tm*D;

	ws=interpRow(theta,-ts);
	wc=interpRow(theta,-tc);

	G=zeros(S*(N+1));

	for k=1:N+1
		G(1:S,(k-1)*S+1:k*S)=ws(k)*Ms+wc(k)*Mc;
	end

	for i=2:N+1
		for k=1:N+1
			G((i-1)*S+1:i*S,(k-1)*S+1:k*S)=D(i,k)*eye(S);
		end
	end

	e=eig(G);
	rho=max(real(e));
end

function w=interpRow(x,x0)

	n=length(x);
	w=zeros(1,n);

	[~,id]=min(abs(x-x0));

	if abs(x(id)-x0)<1e-12
		w(id)=1;
		return;
	end

	c=ones(1,n);

	for j=1:n
		for k=1:n
			if k~=j
				c(j)=c(j)/(x(j)-x(k));
			end
		end
	end

	d=c./(x0-x(:)');
	w=d/sum(d);
end

function [x,D]=chebD(N)

	if N==0
		x=1;
		D=0;
		return;
	end

	x=cos(pi*(0:N)'/N);
	c=[2;ones(N-1,1);2].*(-1).^(0:N)';

	X=repmat(x,1,N+1);
	dX=X-X';

	D=(c*(1./c)')./(dX+eye(N+1));
	D=D-diag(sum(D,2));
end
